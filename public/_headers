# Encabezados para Cloudflare Pages (Netlify los toma de netlify.toml).
# Lo que lleva hash en el nombre no cambia nunca.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El manifiesto con su tipo propio, para que el celular ofrezca instalar la app.
/manifest.webmanifest
  Content-Type: application/manifest+json
