  "entrada": {
   "titulo": "Ruta de entrada · Bienvenida a las Postales",
   "territorio": "Cuaderno Verde, sección Postales · 2 a 3 semanas antes del periodo 1",
   "importancia": "Muchos niños llegan a 3.° sin haber visto inglés. Estos temas, que el MEN ubica en transición y 1.°, nivelan al grupo con vocabulario cercano del salón antes de entrar a los módulos de 3.°.",
   "pensum": "School objects, colors, numbers 1-20, clothes, saludos y expresiones de aula.",
   "evidencia": "Reconoce y nombra vocabulario del salón con apoyo de imagen, gesto y voz."
  },
  "p1": {
   "titulo": "Periodo 1 · Cuido mi salud y la de mi familia",
   "territorio": "Salud y vida · DBA 1 y 4 · MEN 2016b, pp. 153-155",
   "importancia": "Reconocer y expresar con lenguaje sencillo normas y responsabilidades para prevenir problemas de salud en su contexto local.",
   "pensum": "Repaso del cuerpo y hábitos sanos; cold, flu, fever, cough, headache, stomachache, sore throat, dengue; sick, tired; números 100-1000; should / shouldn't; a / an; I have a…",
   "evidencia": "Describe con frases sencillas cómo se siente y da un consejo con should. Tarea final: campaña contra el dengue con carteles en inglés."
  },
  "p2": {
   "titulo": "Periodo 2 · Cumplo mis deberes",
   "territorio": "Convivencia y paz · DBA 3 y 2 · MEN 2016b, pp. 153 y 163",
   "importancia": "Mencionar en inglés sus deberes como miembro de una comunidad, usando un lenguaje sencillo.",
   "pensum": "Duties y normas del salón (raise your hand, do your homework, respect others, tell the truth, don't litter); la hora en punto; rutina del día; our, their; What do you do at 7 o'clock? Where…? When…?",
   "evidencia": "Dice tres deberes y a qué hora hace sus actividades. Tarea final: acuerdo de normas del curso en inglés."
  },
  "p3": {
   "titulo": "Periodo 3 · Cuido mi ciudad",
   "territorio": "Medioambiente y sociedad · DBA 4 y 1 · MEN 2016a, p. 21; 2016b, pp. 153 y 171",
   "importancia": "Identificar y expresar en inglés los efectos de sus acciones en su barrio y su municipio, usando frases sencillas.",
   "pensum": "Park, river, tree, street, school, church, market; repaso de animales y hábitats; littering, polluting, recycling, planting trees; there is / there are; have to / must; imperativos de advertencia.",
   "evidencia": "Describe su barrio en tres o cuatro oraciones y dice una consecuencia. Tarea final: mapa ilustrado del barrio con frases."
  },
  "p4": {
   "titulo": "Periodo 4 · Uso apropiadamente la tecnología",
   "territorio": "Una aldea global · DBA 3, 2 y 1 · MEN 2016a, p. 20; 2016b, pp. 153 y 177",
   "importancia": "Reconocer y presentar en inglés algunas buenas prácticas para el uso responsable de la tecnología.",
   "pensum": "TV, computer, tablet, cell phone, video game; How often…?; every day, twice a day; never, sometimes, often, always; can de posibilidad; diálogos cortos para dar una opinión.",
   "evidencia": "Responde preguntas sobre un texto corto y dice cuánto usa la pantalla. Tarea final: encuesta del curso How often do you…? con gráfica."
  }
