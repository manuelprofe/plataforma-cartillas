      "escenas": {
        "intro": {
          "lineas": [
            {
              "quien": "pixie",
              "es": "¡Hola! Soy Pixie. ¡Qué bueno que llegaste!",
              "en": "Hello! I am Pixie. I am so happy you are here!"
            },
            {
              "quien": "pixie",
              "es": "Englishland se está apagando. Las palabras perdieron su luz.",
              "en": "Englishland is fading. The words lost their light."
            },
            {
              "quien": "cosmo",
              "es": "Yo soy Cosmo. Este es mi hogar: el Bosque de los Sonidos.",
              "en": "I am Cosmo. This is my home: the Forest of Sounds."
            },
            {
              "quien": "cosmo",
              "es": "Cada palabra que aprendes enciende un farol. ¿Me ayudas?",
              "en": "Every word you learn lights a lantern. Will you help me?",
              "opciones": [
                {
                  "es": "¡Sí, vamos!",
                  "en": "Yes, let's go!",
                  "ir": "elegir"
                },
                {
                  "es": "¿Cómo me muevo?",
                  "en": "How do I move?",
                  "ir": "ayuda"
                }
              ]
            }
          ]
        },
        "ayuda": {
          "lineas": [
            {
              "quien": "cosmo",
              "es": "Toca la pantalla y yo vuelo hasta tu dedo. ¡Puedes ir a donde quieras!",
              "en": "Touch the screen and I fly to your finger. You can go anywhere!"
            },
            {
              "quien": "pixie",
              "es": "Si ves una luciérnaga, atrápala. Guarda una palabra.",
              "en": "If you see a firefly, catch it. It keeps a word."
            }
          ],
          "luego": "elegir"
        },
        "elegir": {
          "lineas": [
            {
              "quien": "cosmo",
              "es": "¿A dónde vamos primero? Tú decides.",
              "en": "Where do we go first? You decide.",
              "opciones": [
                {
                  "es": "A los útiles de la escuela",
                  "en": "To the school objects",
                  "icono": "iconos/1f392.svg",
                  "destino": "bosque-school"
                },
                {
                  "es": "A los colores",
                  "en": "To the colors",
                  "icono": "iconos/1f7e3.svg",
                  "destino": "bosque-colors"
                },
                {
                  "es": "A los números",
                  "en": "To the numbers",
                  "icono": "iconos/0033_20e3.svg",
                  "destino": "bosque-numbers"
                }
              ]
            }
          ]
        },
        "lumi": {
          "lineas": [
            {
              "quien": "lumi",
              "es": "¡Hola! Soy Lumi. ¿Te equivocaste alguna vez? ¡No pasa nada!",
              "en": "Hello! I am Lumi. Did you make a mistake? That is okay!"
            },
            {
              "quien": "lumi",
              "es": "Equivocarse es parte de aprender. Dilo conmigo.",
              "en": "Mistakes help us learn. Say it with me.",
              "opciones": [
                {
                  "es": "I can do it!",
                  "en": "I can do it!"
                },
                {
                  "es": "I try again!",
                  "en": "I try again!"
                }
              ]
            },
            {
              "quien": "lumi",
              "es": "¡Así se dice! Sigue explorando.",
              "en": "That is right! Keep exploring."
            }
          ]
        },
        "despues": {
          "lineas": [
            {
              "quien": "cosmo",
              "es": "¡Mira! El bosque tiene más luz. ¿A dónde vamos ahora?",
              "en": "Look! The forest has more light. Where do we go now?"
            }
          ]
        },
        "puente-cerrado": {
          "lineas": [
            {
              "quien": "nova",
              "es": "Soy Nova. Este puente lleva al Valle de las Palabras.",
              "en": "I am Nova. This bridge goes to the Valley of Words."
            },
            {
              "quien": "nova",
              "es": "Necesitamos 50 estrellas para encenderlo. ¡Sigue jugando!",
              "en": "We need 50 stars to light it. Keep playing!"
            }
          ]
        },
        "puente-abierto": {
          "lineas": [
            {
              "quien": "nova",
              "es": "¡Lo lograste! El puente brilla con tus estrellas.",
              "en": "You did it! The bridge shines with your stars."
            },
            {
              "quien": "nova",
              "es": "El Valle de las Palabras abrirá muy pronto. ¡Te espero!",
              "en": "The Valley of Words opens very soon. I will wait for you!"
            }
          ]
        }
      }
